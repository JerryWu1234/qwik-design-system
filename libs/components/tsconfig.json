{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "./",
    "composite": true,
    "allowJs": true,
    "target": "ES2017",
    "module": "esnext",
    "lib": ["es2020", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@qwik.dev/core",
    "strict": true,
    "declaration": true,
    "declarationDir": "lib-types",
    "resolveJsonModule": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "incremental": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src", "vitest", "env.d.ts"],
  "exclude": ["virtual-qds-icons.d.ts", "lib", "lib-types", "node_modules"],
  "references": [{ "path": "../utils" }]
}
