{
  "name": "@qds.dev/ui",
  "version": "0.3.2",
  "description": "Create a Qwik library",
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.qwik.mjs",
      "types": "./lib-types/src/index.d.ts"
    }
  },
  "files": ["lib", "lib-types"],
  "private": false,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run build.lib & pnpm run build.types",
    "build.lib": "rolldown -c rolldown.config.ts",
    "build.types": "tsc --emitDeclarationOnly --project tsconfig.json --outDir ./lib-types --pretty",
    "dev": "vite --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@fluejs/noscroll": "^1.0.0",
    "@qds.dev/utils": "workspace:*",
    "@qwik.dev/core": "2.0.0-beta.11",
    "@types/node": "22.14.0",
    "rolldown": "1.0.0-beta.42",
    "typescript": "5.4.5",
    "uqr": "^0.1.2",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest-browser-qwik": "https://pkg.pr.new/kunai-consulting/vitest-browser-qwik@949e6ac"
  },
  "peerDependencies": {
    "@qwik.dev/core": ">=2.0.0-beta.11"
  },
  "dependencies": {
    "@oddbird/css-anchor-positioning": "^0.6"
  }
}
