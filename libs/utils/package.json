{
  "name": "@qds.dev/utils",
  "version": "0.5.0",
  "description": "Create a Qwik library",
  "main": "./lib/index.qwik.mjs",
  "qwik": "./lib/index.qwik.mjs",
  "types": "./lib-types/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.qwik.mjs",
      "types": "./lib-types/src/index.d.ts"
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "lib-types"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "build": "pnpm run build.lib & pnpm run build.types",
    "build.lib": "rolldown -c rolldown.config.ts",
    "build.types": "tsc --emitDeclarationOnly --incremental --outDir ./lib-types",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "start": "vite --open --mode ssr",
    "test": "echo \"No test specified\" && exit 0",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@types/node": "24.9.0",
    "typescript": "5.4.5",
    "rolldown": "1.0.0-beta.45",
    "@qwik.dev/core": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@d48c3d2"
  },
  "peerDependencies": {
    "@qwik.dev/core": ">=https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@d48c3d2"
  }
}
