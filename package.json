{
  "name": "qwik-design-system",
  "private": true,
  "type": "module",
  "version": "0.4.24",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "dev": "pnpm --filter ./libs/tools dev:watch & sleep 0.7 && pnpm --filter ./docs dev & wait",
    "dev.watch": "pnpm --filter ./libs/tools dev:watch & pnpm --filter ./docs dev & wait",
    "dev.ct": "pnpm --filter ./apps/component-tests dev -- --port 6174",
    "build": "pnpm --filter ./libs/tools build && pnpm --filter ./libs/utils build && pnpm --filter ./libs/components build && pnpm --filter ./docs build && cp -r ./docs/dist/pagefind ./docs/public",
    "preview": "pnpm --filter ./docs preview",
    "check": "oxlint . --type-aware && biome format .",
    "check.format": "biome format .",
    "check.lint": "oxlint . --type-aware",
    "fix": "pnpm lint && pnpm format",
    "format": "biome format --write .",
    "lint": "oxlint . --type-aware --fix",
    "test": "vitest",
    "changeset": "changeset",
    "changelog": "changelogen --output CHANGELOG.md --no-commit --no-tag",
    "publish": "pnpm --filter '@qds.dev/*' publish --access public --no-git-checks",
    "release": "bumpp package.json libs/*/package.json --execute \"pnpm changelog\" --all --commit \"chore: release v%s\" --tag \"v%s\" --push",
    "release.patch": "bumpp package.json libs/*/package.json --patch --execute \"pnpm changelog\" --all --commit \"chore: release v%s\" --tag \"v%s\" --push && pnpm run publish",
    "release.minor": "bumpp package.json libs/*/package.json --minor --execute \"pnpm changelog\" --all --commit \"chore: release v%s\" --tag \"v%s\" --push && pnpm run publish",
    "version:packages": "changeset version",
    "create-linear-issue": "node .github/scripts/update-linear.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@biomejs/biome": "2.3.0",
    "@changesets/cli": "^2.27.7",
    "@linear/sdk": "^27.0.0",
    "@qds.dev/tools": "workspace:*",
    "@qwik.dev/core": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@d48c3d2",
    "@types/node": "24.9.0",
    "@vitest/browser-playwright": "^4.0.3",
    "@vitest/ui": "^4.0.3",
    "axe-core": "^4.10.3",
    "bumpp": "^10.3.1",
    "changelogen": "^0.6.2",
    "lefthook": "^2.0.1",
    "oxc-parser": "^0.94.0",
    "oxlint": "^1.24.0",
    "oxlint-tsgolint": "^0.3.0",
    "pagefind": "1.2.0",
    "pathe": "^2.0.3",
    "pkg-pr-new": "^0.0.56",
    "playwright": "^1.56.0",
    "vitest": "^4.0.3"
  },
  "pnpm": {
    "overrides": {
      "ansi-regex": "5.0.1",
      "ansi-styles": "6.2.3",
      "chalk": "5.6.2",
      "color-convert": "3.1.2",
      "color-name": "2.0.2",
      "debug": "4.4.3",
      "strip-ansi": "6.0.1",
      "supports-color": "10.2.2",
      "wrap-ansi": "9.0.2"
    }
  }
}
