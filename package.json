{
  "name": "qwik-design-system",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@9.14.4",
  "scripts": {
    "dev": "pnpm --filter ./libs/tools dev:watch & sleep 0.7 && pnpm --filter ./docs dev & wait",
    "dev.watch": "pnpm --filter ./libs/tools dev:watch & pnpm --filter ./docs dev & wait",
    "dev.ct": "pnpm --filter ./apps/component-tests dev -- --port 6174",
    "build": "pnpm --filter ./libs/tools build && pnpm --filter ./libs/utils build && pnpm --filter ./libs/components build && pnpm --filter ./docs build && cp -r ./docs/dist/pagefind ./docs/public",
    "preview": "pnpm --filter ./docs preview",
    "check": "biome ci .",
    "check.format": "biome format .",
    "check.lint": "biome check .",
    "fix": "pnpm lint && pnpm format",
    "format": "biome format --write .",
    "lint": "biome check --write --unsafe .",
    "test": "vitest",
    "changeset": "changeset",
    "publish:packages": "changeset publish",
    "version:packages": "changeset version",
    "create-linear-issue": "tsx .github/scripts/update-linear.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.33.1",
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.27.7",
    "@linear/sdk": "^27.0.0",
    "@qwik.dev/core": "2.0.0-beta.11",
    "@types/node": "22.14.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/ui": "3.2.4",
    "axe-core": "^4.10.3",
    "oxc-parser": "^0.94.0",
    "pagefind": "1.2.0",
    "pathe": "^2.0.3",
    "pkg-pr-new": "^0.0.56",
    "playwright": "^1.56.0",
    "tsx": "^4.19.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "ansi-regex": "6.2.2",
      "ansi-styles": "6.2.3",
      "chalk": "5.6.2",
      "color-convert": "3.1.2",
      "color-name": "2.0.2",
      "debug": "4.4.3",
      "strip-ansi": "7.1.2",
      "supports-color": "10.2.2",
      "wrap-ansi": "9.0.2"
    }
  }
}
